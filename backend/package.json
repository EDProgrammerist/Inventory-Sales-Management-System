{
    "name": "kanban-backend",
    "version": "1.0.0",
    "description": "Kanban Express TypeScript MVC API starter",
    "main": "dist/server.mjs",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && tsdown src/server.ts --format esm --clean --minify",
        "start": "node dist/server.mjs",
        "lint": "eslint .",
        "test": "tsx --test tests/*.test.ts",
        "db:studio": "drizzle-kit studio",
        "db:plan": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:check": "tsx scripts/check-database.ts",
        "db:seed-admin": "tsx scripts/seed-admin.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-csrf": "^4.0.3",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/hpp": "^0.2.7",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.13.0",
        "jiti": "^2.7.0",
        "tsdown": "^0.23.4",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "overrides": {}
}
